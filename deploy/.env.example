# Salin menjadi .env di VPS:  cp .env.example .env   lalu ganti nilainya.
# JANGAN commit file .env ke GitHub.

# Lokasi image di registry, contoh Docker Hub: docker.io/usernamekamu
# atau GHCR: ghcr.io/usernamegithubkamu (huruf kecil semua)
IMAGE_PREFIX=docker.io/usernamekamu
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=ganti-dengan-password-kuat
DB_NAME=tododb
DB_USER=todo
DB_PASSWORD=ganti-dengan-password-kuat-lain

# Port publik di VPS
APP_PORT=80
